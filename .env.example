# Copy this file to .env.local and fill in the values below.

# Neon Postgres connection string. From the Neon dashboard: Project ->
# Connect -> "Connection string" (use the pooled connection string).
# See README.md "Setting up Neon" for the full walkthrough.
DATABASE_URL=postgres://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional. Only needed to use real Vercel Blob storage for screenshots.
# Without it, uploaded images are written to ./public/uploads for local dev.
# Vercel dashboard: Project -> Storage -> Blob -> create a store -> copy the
# read/write token.
BLOB_READ_WRITE_TOKEN=
